9d2\uff0c\u5c5e\u4e8e\u77ed\u65f6\u9ad8\u9891\u653b\u51fb\u6a21\u5f0f\u3002\n\n## 3. \u6d41\u91cf\u7279\u5f81\u5206\u6790\n\n*   **\u670d\u52a1/\u534f\u8bae\u5206\u5e03\uff1a**\n    *   \u7edd\u5927\u591a\u6570\u6d41\u91cf\u672a\u6807\u8bb0\u660e\u786e\u670d\u52a1\uff08`-`\uff0c 776,720\u6b21\uff09\uff0c\u8fd9\u53ef\u80fd\u5305\u542b\u5927\u91cf\u539f\u59cb\u653b\u51fb\u8f7d\u8377\u6216\u975e\u6807\u51c6\u534f\u8bae\u6d41\u91cf\u3002\n    *   **DNS\u670d\u52a1** \u5173\u8054\u7684\u6076\u610f\u4e8b\u4ef6\u9ad8\u8fbe **326,878** \u6b21\uff0c\u7ed3\u5408DoS\u653b\u51fb\u7684\u7279\u5f81\uff0c\u8fdb\u4e00\u6b65\u8bc1\u5b9e\u4e86\u5229\u7528DNS\u534f\u8bae\u8fdb\u884c\u53cd\u5c04\u653e\u5927\u653b\u51fb\u7684\u53ef\u80fd\u6027\u3002\n    *   **HTTP\u670d\u52a1** \u5173\u8054\u4e8b\u4ef6\u4e3a **113,909** \u6b21\uff0c\u662fWeb\u5e94\u7528\u653b\u51fb\u7684\u4e3b\u8981\u5165\u53e3\u3002\n    *   \u5176\u4ed6\u5982FTP\u3001SMTP\u3001SSH\u7b49\u5e38\u89c1\u670d\u52a1\u4e5f\u906d\u53d7\u4e86\u4e0d\u540c\u7a0b\u5ea6\u7684\u653b\u51fb\uff0c\u8868\u660e\u653b\u51fb\u9762\u8986\u76d6\u5e7f\u6cdb\u3002\n\n*   **IP\u5730\u5740\u5206\u6790\uff1a**\n    *   **\u653b\u51fb\u6e90\u9ad8\u5ea6\u96c6\u4e2d\uff1a** \u6392\u540d\u524d\u5341\u7684\u6e90IP\u5747\u6765\u81ea\u4e24\u4e2aC\u6bb5\uff1a`175.45.176.0/24`\uff08\u524d4\u4f4d\uff09\u548c `59.166.0.0/24`\uff08\u540e6\u4f4d\uff09\u3002\u8fd9\u4e24\u4e2a\u7f51\u6bb5\u53d1\u8d77\u7684\u653b\u51fb\u4e8b\u4ef6\u603b\u6570\u8d85\u8fc7 **1,079,000\u6b21**\uff0c\u5360\u653b\u51fb\u603b\u91cf\u7684\u7edd\u5927\u90e8\u5206\u3002\u8fd9\u79cd\u96c6\u4e2d\u6027\u53ef\u80fd\u6307\u5411\u50f5\u5c38\u7f51\u7edc\uff08Botnet\uff09\u7684\u6307\u6325\u63a7\u5236\uff08C&C\uff09\u670d\u52a1\u5668\u6216\u5df2\u88ab\u653b\u9677\u7684\u5927\u89c4\u6a21\u8df3\u677f\u673a\u3002\n    *   **\u653b\u51fb\u76ee\u6807\u660e\u786e\u96c6\u4e2d\uff1a** \u6392\u540d\u524d\u5341\u7684\u76ee\u7684IP\u5168\u90e8\u5c5e\u4e8e `149.171.126.0/24` \u7f51\u6bb5\u3002\u5176\u4e2d `149.171.126.18` \u906d\u53d7\u7684\u653b\u51fb\u6b21\u6570\uff08242,418\u6b21\uff09\u8fdc\u8d85\u5176\u4ed6IP\uff0c\u8868\u660e\u5176\u53ef\u80fd\u662f\u653b\u51fb\u8005\u7684\u9996\u8981\u76ee\u6807\u3002\u8be5\u7f51\u6bb5\u5e94\u88ab\u8ba4\u5b9a\u4e3a **\u9ad8\u98ce\u9669\u8d44\u4ea7\u96c6\u5408**\u3002\n\n## 4. \u65f6\u95f4\u5206\u5e03\u7279\u5f81\n\n\u672c\u6b21\u63d0\u4f9b\u7684\u6570\u636e\u4e2d\u672a\u5305\u542b\u653b\u51fb\u4e8b\u4ef6\u7684\u5c0f\u65f6\u7ea7\u65f6\u95f4\u5e8f\u5217\u6570\u636e\uff08`attack_hours` \u4e3a\u7a7a\uff09\uff0c\u56e0\u6b64\u65e0\u6cd5\u8fdb\u884c\u7cbe\u786e\u768424\u5c0f\u65f6\u653b\u51fb\u5cf0\u503c\u5468\u671f\u5206\u6790\u3002\u5efa\u8bae\u5728\u540e\u7eed\u6570\u636e\u6536\u96c6\u4e2d\u8865\u5145\u65f6\u95f4\u6233\u4fe1\u606f\uff0c\u4ee5\u4fbf\u5206\u6790\u653b\u51fb\u662f\u5426\u5177\u6709\u5de5\u4f5c\u65f6\u95f4\u3001\u591c\u95f4\u6216\u5468\u672b\u7b49\u5468\u671f\u6027\u89c4\u5f8b\uff0c\u8fd9\u5bf9\u4e8e\u8c03\u6574\u9632\u62a4\u7b56\u7565\u548c\u503c\u5b88\u5b89\u6392\u81f3\u5173\u91cd\u8981\u3002\n\n## 5. \u98ce\u9669\u8bc4\u4f30\n\n| \u98ce\u9669\u7ef4\u5ea6 | \u8bc4\u4f30\u7b49\u7ea7 | \u8bf4\u660e |\n| :--- | :--- | :--- |\n| **\u653b\u51fb\u89c4\u6a21** | \u4e25\u91cd | \u653b\u51fb\u4e8b\u4ef6\u603b\u91cf\u8d85\u8fc7135\u4e07\u6b21\uff0c\u89c4\u6a21\u5de8\u5927\u3002 |\n| **\u653b\u51fb\u590d\u6742\u6027** | \u9ad8 | \u653b\u51fb\u7c7b\u578b\u8986\u76d6\u4fa6\u5bdf\u3001\u6f0f\u6d1e\u5229\u7528\u3001DoS\u3001\u540e\u95e8\u690d\u5165\u7b49\u591a\u4e2a\u9636\u6bb5\uff0c\u624b\u6cd5\u591a\u6837\u3002 |\n| **\u653b\u51fb\u9488\u5bf9\u6027** | \u9ad8 | \u653b\u51fb\u6e90\u4e0e\u76ee\u6807IP\u5747\u8868\u73b0\u51fa\u9ad8\u5ea6\u96c6\u4e2d\u6027\uff0c\u8868\u660e\u975e\u968f\u673a\u626b\u63cf\uff0c\u800c\u662f\u6709\u660e\u786e\u76ee\u6807\u7684\u653b\u51fb\u6d3b\u52a8\u3002 |\n| **\u4e1a\u52a1\u5f71\u54cd** | \u4e2d-\u9ad8 | \u5927\u91cfDoS\u653b\u51fb\u53ef\u80fd\u76f4\u63a5\u5f71\u54cd `149.171.126.0/24` \u7f51\u6bb5\u670d\u52a1\u7684\u53ef\u7528\u6027\uff1b\u540e\u95e8\u548c\u6f0f\u6d1e\u5229\u7528\u6210\u529f\u53ef\u80fd\u5bfc\u81f4\u6570\u636e\u6cc4\u9732\u548c\u7cfb\u7edf\u5931\u9677\u3002 |\n| **\u6574\u4f53\u98ce\u9669\u7b49\u7ea7** | **\u9ad8** | \u7efc\u5408\u653b\u51fb\u89c4\u6a21\u3001\u590d\u6742\u6027\u548c\u9488\u5bf9\u6027\uff0c\u5f53\u524d\u7f51\u7edc\u9762\u4e34\u9ad8\u7ea7\u522b\u6301\u7eed\u5a01\u80c1\u3002 |\n\n## 6. \u9632\u62a4\u5efa\u8bae\n\n1.  **\u7acb\u5373\u904f\u5236\u4e0e\u8fb9\u754c\u9632\u62a4\uff1a**\n    *   \u5728\u9632\u706b\u5899\u6216IPS\u4e0a\uff0c\u7acb\u5373\u5bf9\u6e90\u5934IP\u6bb5 `175.45.176.0/24` \u548c `59.166.0.0/24` \u5b9e\u65bd**\u4e34\u65f6\u6216\u6c38\u4e45\u6027\u5c01\u9501**\u3002\n    *   \u9488\u5bf9 `149.171.126.0/24` \u76ee\u6807\u7f51\u6bb5\uff0c\u68c0\u67e5\u5e76\u914d\u7f6e\u4e25\u683c\u7684\u5165\u7ad9\u8bbf\u95ee\u63a7\u5236\u7b56\u7565\uff08ACL\uff09\uff0c\u4ec5\u5f00\u653e\u5fc5\u8981\u7684\u4e1a\u52a1\u7aef\u53e3\u3002\n    *   \u542f\u7528\u5e76\u4f18\u5316\u6297DDoS\u9632\u62a4\u7b56\u7565\uff0c\u91cd\u70b9\u5173\u6ce8DNS\u3001NTP\u7b49\u534f\u8bae\u7684\u53cd\u5c04\u653e\u5927\u653b\u51fb\u3002\n\n2.  **\u8d44\u4ea7\u52a0\u56fa\u4e0e\u6f0f\u6d1e\u7ba1\u7406\uff1a**\n    *   \u5bf9 `149.171.126.0/24` \u7f51\u6bb5\u5185\u7684\u6240\u6709\u8d44\u4ea7\uff08\u5c24\u5176\u662f `.18` \u4e3b\u673a\uff09\u8fdb\u884c**\u7d27\u6025\u5b89\u5168\u8bc4\u4f30**\uff0c\u68c0\u67e5\u662f\u5426\u5b58\u5728\u5df2\u77e5\u6f0f\u6d1e\uff08\u5bf9\u5e94Exploits\u653b\u51fb\uff09\uff0c\u5e76\u7acb\u5373\u5b89\u88c5\u8865\u4e01\u3002\n    *   \u68c0\u67e5\u5173\u952e\u670d\u52a1\u5668\uff08\u7279\u522b\u662f\u63d0\u4f9bDNS\u3001HTTP\u670d\u52a1\u7684\uff09\u662f\u5426\u5b58\u5728\u88ab\u690d\u5165\u540e\u95e8\uff08Backdoors\uff09\u6216Webshell\u7684\u8ff9\u8c61\u3002\n    *   \u5f3a\u5316SSH\u3001FTP\u7b49\u670d\u52a1\u7684\u5b89\u5168\u914d\u7f6e\uff0c\u5982\u4f7f\u7528\u5bc6\u94a5\u8ba4\u8bc1\u3001\u9650\u5236\u8bbf\u95eeIP\u3001\u66f4\u