48c\u6076\u610f\u8f6f\u4ef6\u4f20\u64ad\u7684\u6e20\u9053\u3002\n\n### 3.2 \u653b\u51fb\u6e90\u4e0e\u76ee\u6807\u5206\u6790\n**Top 10 \u653b\u51fb\u6e90IP:**\n\u653b\u51fb\u6d41\u91cf\u5448\u73b0\u51fa\u6781\u9ad8\u7684\u6e90IP\u96c6\u4e2d\u5ea6\u3002\u6392\u540d\u524d10\u7684\u6e90IP\u8d21\u732e\u4e86\u7edd\u5927\u90e8\u5206\u653b\u51fb\u6d41\u91cf\uff0c\u4e14\u4e3b\u8981\u5f52\u5c5e\u4e8e `175.45.176.0/24` \u548c `59.166.0.0/24` \u4e24\u4e2aC\u7c7b\u5730\u5740\u6bb5\u3002\u8fd9\u79cd\u6a21\u5f0f\u5f3a\u70c8\u6697\u793a\u653b\u51fb\u6e90\u81ea\u88ab\u63a7\u5236\u7684**\u50f5\u5c38\u7f51\u7edc\uff08Botnet\uff09** \u6216\u79df\u7528\u7684**\u865a\u62df\u4e13\u7528\u670d\u52a1\u5668\uff08VPS\uff09\u96c6\u7fa4**\uff0c\u7528\u4e8e\u53d1\u8d77\u5206\u5e03\u5f0f\u653b\u51fb\u3002\n\n**Top 10 \u76ee\u6807IP:**\n\u6240\u6709\u9ad8\u9891\u7387\u653b\u51fb\u76ee\u6807IP\u5747\u4f4d\u4e8e `149.171.126.0/24` \u7f51\u6bb5\u3002\u5176\u4e2d `149.171.126.18` \u906d\u53d7\u7684\u653b\u51fb\u6b21\u6570\uff08242,418\u6b21\uff09\u8fdc\u8d85\u5176\u4ed6\u4e3b\u673a\uff0c\u8868\u660e\u8be5\u4e3b\u673a\u53ef\u80fd\u4e3a\u5bf9\u5916\u63d0\u4f9b\u91cd\u8981\u670d\u52a1\u7684\u670d\u52a1\u5668\uff08\u5982Web\u3001\u6570\u636e\u5e93\u670d\u52a1\u5668\uff09\uff0c\u662f\u653b\u51fb\u8005\u7684\u9996\u8981\u76ee\u6807\u3002\u76ee\u6807\u7684\u9ad8\u5ea6\u96c6\u4e2d\u5316\u8bf4\u660e\u653b\u51fb\u5177\u6709\u660e\u786e\u7684\u9488\u5bf9\u6027\u3002\n\n## 4. \u65f6\u95f4\u5206\u5e03\u7279\u5f81\n\u672c\u6b21\u63d0\u4f9b\u7684\u6570\u636e\u4e2d\u672a\u5305\u542b\u653b\u51fb\u65f6\u95f4\uff08\u5c0f\u65f6\u7ea7\uff09\u7684\u5206\u5e03\u4fe1\u606f\u3002\u5efa\u8bae\u5728\u540e\u7eed\u5206\u6790\u4e2d\u542f\u7528\u5e76\u6536\u96c6\u65f6\u95f4\u5e8f\u5217\u6570\u636e\uff0c\u4ee5\u8bc6\u522b\u653b\u51fb\u662f\u5426\u5728\u7279\u5b9a\u65f6\u6bb5\uff08\u5982\u5de5\u4f5c\u65f6\u95f4\u5916\u3001\u5468\u672b\uff09\u66f4\u4e3a\u6d3b\u8dc3\uff0c\u4ece\u800c\u5224\u65ad\u653b\u51fb\u662f\u81ea\u52a8\u5316\u811a\u672c\u6267\u884c\u8fd8\u662f\u4eba\u5de5\u53c2\u4e0e\uff0c\u5e76\u4e3a\u5b89\u5168\u8fd0\u7ef4\u6392\u73ed\u548c\u52a8\u6001\u9632\u5fa1\u7b56\u7565\u8c03\u6574\u63d0\u4f9b\u4f9d\u636e\u3002\n\n## 5. \u98ce\u9669\u8bc4\u4f30\n\n\u7efc\u5408\u4ee5\u4e0a\u5206\u6790\uff0c\u5bf9\u5f53\u524d\u7f51\u7edc\u5b89\u5168\u98ce\u9669\u7b49\u7ea7\u8bc4\u4f30\u5982\u4e0b\uff1a\n\n*   **\u98ce\u9669\u7b49\u7ea7\uff1a\u9ad8**\n*   **\u5f71\u54cd\u8303\u56f4\uff1a** \u4e3b\u8981\u5f71\u54cd `149.171.126.0/24` \u7f51\u6bb5\u5185\u7684\u4e1a\u52a1\u7cfb\u7edf\uff0c\u5c24\u5176\u662f\u9ad8\u8d1f\u8f7d\u4e3b\u673a\u3002\u9488\u5bf9DNS\u3001Web\u7b49\u57fa\u7840\u670d\u52a1\u7684\u653b\u51fb\u53ef\u80fd\u5f71\u54cd\u6574\u4e2a\u7f51\u7edc\u7684\u7a33\u5b9a\u6027\u548c\u53ef\u7528\u6027\u3002\n*   **\u53ef\u80fd\u6027\uff1a** \u6781\u9ad8\u3002\u653b\u51fb\u6b63\u5728\u6301\u7eed\u53d1\u751f\uff0c\u4e14\u653b\u51fb\u6e90\u5177\u5907\u5f3a\u5927\u7684\u6301\u7eed\u8f93\u51fa\u80fd\u529b\u3002\n*   **\u6f5c\u5728\u5f71\u54cd\uff1a**\n    *   **\u670d\u52a1\u4e2d\u65ad\uff1a** DoS\u653b\u51fb\u53ef\u80fd\u5bfc\u81f4\u5173\u952e\u4e1a\u52a1\u7f51\u7ad9\u6216\u670d\u52a1\u4e0d\u53ef\u7528\u3002\n    *   **\u6570\u636e\u6cc4\u9732\uff1a** \u6210\u529f\u7684\u6f0f\u6d1e\u5229\u7528\u6216\u540e\u95e8\u53ef\u80fd\u5bfc\u81f4\u654f\u611f\u6570\u636e\u88ab\u7a83\u53d6\u3002\n    *   **\u7cfb\u7edf\u5931\u9677\uff1a** \u653b\u51fb\u94fe\u7684\u5b8c\u6574\u6027\u610f\u5473\u7740\u653b\u51fb\u8005\u53ef\u80fd\u5df2\u83b7\u5f97\u90e8\u5206\u7cfb\u7edf\u7684\u63a7\u5236\u6743\uff0c\u5f62\u6210\u6301\u4e45\u5316\u5a01\u80c1\u3002\n    *   **\u6a2a\u5411\u79fb\u52a8\uff1a** \u653b\u51fb\u8005\u53ef\u80fd\u4ee5\u5df2\u63a7\u5236\u7684\u4e3b\u673a\u4e3a\u8df3\u677f\uff0c\u5411\u5185\u7f51\u5176\u4ed6\u533a\u57df\u6e17\u900f\u3002\n\n## 6. \u9632\u62a4\u5efa\u8bae\n\n\u57fa\u4e8e\u201c\u7eb5\u6df1\u9632\u5fa1\u201d\u539f\u5219\uff0c\u63d0\u51fa\u4ee5\u4e0b\u5206\u7ea7\u9632\u62a4\u5efa\u8bae\uff1a\n\n1.  **\u7acb\u5373\u904f\u5236\u63aa\u65bd\uff1a**\n    *   **\u8fb9\u754c\u5c01\u9501\uff1a** \u5728\u9632\u706b\u5899\u6216\u5165\u4fb5\u9632\u5fa1\u7cfb\u7edf\uff08IPS\uff09\u4e0a\uff0c\u7acb\u5373\u5bf9\u8bc6\u522b\u51fa\u7684\u9876\u7ea7\u653b\u51fb\u6e90IP\u6bb5\uff08`175.45.176.0/24`\uff0c `59.166.0.0/24`\uff09\u5b9e\u65bd\u5730\u7406\u533a\u57df\u6216IP\u8303\u56f4\u7684\u5c01\u9501\u7b56\u7565\u3002\n    *   **\u76ee\u6807\u4e3b\u673a\u52a0\u56fa\uff1a** \u5bf9\u91cd\u70b9\u76ee\u6807IP\uff08\u5982 `149.171.126.18`\uff09\u8fdb\u884c\u7d27\u6025\u5b89\u5168\u68c0\u67e5\uff0c\u5305\u62ec\u6f0f\u6d1e\u4fee\u8865\u3001\u65e5\u5fd7\u5ba1\u8ba1\u3001\u6392\u67e5\u662f\u5426\u5b58\u5728\u5df2\u690d\u5165\u7684\u540e\u95e8\u6216Webshell\u3002\n\n2.  **\u77ed\u671f\u9632\u62a4\u5f3a\u5316\uff1a**\n    *   **\u4f18\u5316\u68c0\u6d4b\u89c4\u5219\uff1a** \u6839\u636e\u672c\u6b21\u53d1\u73b0\u7684\u653b\u51fb\u7c7b\u578b\uff08\u7279\u522b\u662fExploits\uff0c Fuzzers\uff0c Generic\uff09\uff0c\u66f4\u65b0\u7f51\u7edcIDS/IPS\u548c\u7ec8\u7aefEDR\u7684\u68c0\u6d4b\u89c4\u5219\u5e93\u3002\n    *   **\u5e94\u7528\u5c42\u9632\u62a4\uff1a** \u9488\u5bf9HTTP\u3001DNS\u670d\u52a1\u7684\u9ad8\u9891\u653b\u51fb\uff0c\u90e8\u7f72\u6216\u542f\u7528Web\u5e94\u7528\u9632\u706b\u5899\uff08WAF\uff09\u548cDNS\u5b89\u5168\u9632\u62a4\u3002\n    *   **\u670d\u52a1\u6700\u5c0f\u5316\uff1a** \u5ba1\u67e5 `149.171.126.0/24` \u7f51\u6bb5\u4e3b\u673a\uff0c\u5173\u95ed\u975e\u5fc5\u8981\u7684\u670d\u52a1\u7aef\u53e3\uff08\u5982\u4e0d\u5fc5\u8981\u7684FTP\u3001POP3\uff09\u3002\n\n3.  **\u4e2d\u957f\u671f\u5b89\u5168\u5efa\u8bbe\uff1a**\n    *   **\u5a01\u80c1\u60c5\u62a5\u96c6\u6210\uff1a** \u8ba2\u9605\u5a01\u80c1\u60c5\u62a5\u670d\u52a1\uff0c\u5c06\u672c\u6b21\u53d1\u73b0\u7684\u6076\u610fIP\u52a0\u5165\u60c5\u62a5\u5e93\u8fdb\u884c\u6301\u7eed\u76d1\u63a7\uff0c\u5e76\u83b7\u53d6\u5176\u5173\u8054\u7684C2\u670d\u52a1\u5668\u3001\u6076\u610f\u8f6f\u4ef6\u5bb6\u65cf\u7b49\u4fe1\u606f\u3002\n    *   **\u7f51\u7edc\u5206\u6bb5\uff1a** \u5bf9\u6838\u5fc3\u4e1a\u52a1\u7f51\u6bb5\uff08`149.171.126.0/24`\uff09\u8fdb\u884c\u66f4\u4e25\u683c\u7684\u7f51\u7edc\u5206\u6bb5\u548c\u8bbf\u95ee\u63a7\u5236\uff0c\u9650\u5236\u4e1c\u897f\u5411\u6d41\u91cf\u3002\n    *   **\u589e\u5f3a\u76d1\u63a7\u4e0e\u54cd\u5e94\uff1a** \u90e8\u7f72\u5b89\u5168\u7f16\u6392\u3001\u81ea\u52a8\u5316\u4e0e\u54cd\u5e94\uff08SOAR\uff09\u5e73\u53f0\uff0c\u63d0\u5347\u5bf9\u7c7b\u4f3c\u5927\u89c4\u6a21\u81ea\u52a8\u5316\u653b\u51fb\u7684\u54cd\u5e94\u901f\u5ea6\u3002\u5b8c\u5584\u65e5\u5fd7\u6536\u96c6\u4f53\u7cfb\uff0c\u786e\u4fdd\u80fd\u8fdb\u884c\u66f4\u6df1\u5165\u7684\u4e8b\u4ef6\u6eaf\u6e90\u3002\n    *   **\u5b89\u5168\u610f\u8bc6\u57f9\u8bad\uff1a** \u9632\u8303\u901a\u8fc7SMTP/POP3\u8fdb\u884c\u7684\u9493\u9c7c\u653b\u51fb\uff0c\u5bf9\u5458\u5de5\u8fdb\u884c\u5b89\u5168\u610f\u8bc6\u6559\u80b2\u3002\n\n## 7"
